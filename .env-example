# ---------------------------------------------------------------------------
# Offline / LAN configuration
#
# This build needs no MongoDB, no Firebase and no external service:
#   - data is stored in a local SQLite file (node:sqlite, no native module)
#   - identity is a local nickname, sent to the server as a bearer token
#
# Everything below is OPTIONAL. The game starts with an empty .env.
# ---------------------------------------------------------------------------

# SQLite database file. Default: ./data/pokemon-auto-chess.db
# Point this somewhere writable on mobile (e.g. the app's private folder).
SQLITE_PATH=

# HTTP/WebSocket port. Default: 9000
PORT=9000

# Password for the Colyseus admin panel at /colyseus
ADMIN_PASSWORD=

# Minimum number of human players required to start a game. Default: 1
# Keep this at 1 to allow solo games against bots.
MIN_HUMAN_PLAYERS=1
